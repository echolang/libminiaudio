use std::io;

test load_sine
{
    ma::Engine $engine = offlineEngine();
    ma::Sound $sound = guard $engine->sound(sinePath()) else ($e) {
        die("{$e}");
    }

    uint64 $len = guard $sound->length() else ($e) {
        die("{$e}");
    }

    assert($len > 0);
}

test load_sine_from_memory
{
    ma::Engine $engine = offlineEngine();
    string $bytes = guard io::readfile(sinePath()) else ($e) {
        die("{$e->message()}");
    }
    ma::Sound $fromFile = guard $engine->sound(sinePath()) else ($e) {
        die("{$e}");
    }
    ma::Sound $fromMem = guard $engine->sound(memory: $bytes) else ($e) {
        die("{$e}");
    }

    uint64 $fileLen = guard $fromFile->length() else ($e) {
        die("{$e}");
    }
    uint64 $memLen = guard $fromMem->length() else ($e) {
        die("{$e}");
    }
    assert($fileLen == $memLen);
    assert($memLen > 0);
}

test memory_empty_is_invalid_args
{
    ma::Engine $engine = offlineEngine();
    result<ma::Sound, ma::Error> $r = $engine->sound(memory: '');
    assert($r->failed());
    ma::Error $e = $r->failure();
    match ($e) {
        ma::Error::invalidArgs => {},
        else => { assert(false, 'expected invalidArgs'); },
    };
}

test memory_garbage_fails
{
    ma::Engine $engine = offlineEngine();
    result<ma::Sound, ma::Error> $r = $engine->sound(memory: 'not a wav');
    assert($r->failed());
}

test memory_decode_option
{
    ma::Engine $engine = offlineEngine();
    string $bytes = guard io::readfile(sinePath()) else ($e) {
        die("{$e->message()}");
    }
    ma::Sound $fromFile = guard $engine->sound(sinePath(), ma::SoundOptions($decode: true)) else ($e) {
        die("{$e}");
    }
    ma::Sound $fromMem = guard $engine->sound(memory: $bytes, ma::SoundOptions($decode: true)) else ($e) {
        die("{$e}");
    }

    uint64 $fileLen = guard $fromFile->length() else ($e) {
        die("{$e}");
    }
    uint64 $memLen = guard $fromMem->length() else ($e) {
        die("{$e}");
    }
    assert($fileLen == $memLen);
    assert($memLen > 0);
}

test memory_stream_is_ignored
{
    ma::Engine $engine = offlineEngine();
    string $bytes = guard io::readfile(sinePath()) else ($e) {
        die("{$e->message()}");
    }
    ma::Sound $sound = guard $engine->sound(memory: $bytes, ma::SoundOptions($stream: true)) else ($e) {
        die("{$e}");
    }

    uint64 $len = guard $sound->length() else ($e) {
        die("{$e}");
    }
    assert($len > 0);
}

test memory_start_and_read
{
    ma::Engine $engine = offlineEngine();
    string $bytes = guard io::readfile(sinePath()) else ($e) {
        die("{$e->message()}");
    }
    ma::Sound $sound = guard $engine->sound(memory: $bytes) else ($e) {
        die("{$e}");
    }

    guard $sound->start() else ($e) {
        die("{$e}");
    }
    assert($sound->isPlaying());

    array<float32> $frames = guard $engine->read(1024) else ($e) {
        die("{$e}");
    }

    assert($frames->count() == 2048);

    float32 $energy = 0.0f;
    usize $i = 0;

    while ($i < $frames->count()) {
        float32 $s = $frames[$i];
        $energy = $energy + ($s * $s);
        $i = $i + 1;
    }

    assert($energy > 0.0f);
}

test missing_file
{
    ma::Engine $engine = offlineEngine();
    result<ma::Sound, ma::Error> $r = $engine->sound('tests/resources/no-such-file.wav');
    assert($r->failed());
    ma::Error $e = $r->failure();
    match ($e) {
        ma::Error::doesNotExist => {},
        else => { assert(false, 'expected doesNotExist'); },
    };
}

test looping_option
{
    ma::Engine $engine = offlineEngine();
    ma::Sound $sound = guard $engine->sound(sinePath(), ma::SoundOptions($looping: true)) else ($e) {
        die("{$e}");
    }

    assert($sound->looping());
    $sound->setLooping(false);
    assert(!$sound->looping());
}

test volume_pan_pitch
{
    ma::Engine $engine = offlineEngine();
    ma::Sound $sound = guard $engine->sound(sinePath()) else ($e) {
        die("{$e}");
    }

    $sound->setVolume(0.25f);
    $sound->setPan(-0.5f);
    $sound->setPitch(1.5f);
    assert($sound->volume() > 0.24f && $sound->volume() < 0.26f);
    assert($sound->pan() < -0.4f);
    assert($sound->pitch() > 1.4f);
}

test start_and_read
{
    ma::Engine $engine = offlineEngine();
    ma::Sound $sound = guard $engine->sound(sinePath()) else ($e) {
        die("{$e}");
    }

    guard $sound->start() else ($e) {
        die("{$e}");
    }
    assert($sound->isPlaying());

    array<float32> $frames = guard $engine->read(1024) else ($e) {
        die("{$e}");
    }

    assert($frames->count() == 2048);

    float32 $energy = 0.0f;
    usize $i = 0;

    while ($i < $frames->count()) {
        float32 $s = $frames[$i];
        $energy = $energy + ($s * $s);
        $i = $i + 1;
    }

    assert($energy > 0.0f);
}

test seek_to_start
{
    ma::Engine $engine = offlineEngine();
    ma::Sound $sound = guard $engine->sound(sinePath()) else ($e) {
        die("{$e}");
    }

    guard $sound->start() else ($e) {
        die("{$e}");
    }

    guard $sound->seek(0) else ($e) {
        die("{$e}");
    }
}

test group_volume
{
    ma::Engine $engine = offlineEngine();
    ma::SoundGroup $group = guard $engine->group() else ($e) {
        die("{$e}");
    }

    $group->setVolume(0.5f);
    float32 $v = $group->volume();
    assert($v > 0.49f && $v < 0.51f);

    ma::Sound $sound = guard $engine->sound(sinePath(), group: $group) else ($e) {
        die("{$e}");
    }

    guard $sound->start() else ($e) {
        die("{$e}");
    }
    assert($sound->isPlaying());
}

test spatial_position
{
    ma::Engine $engine = offlineEngine();
    ma::Sound $sound = guard $engine->sound(sinePath()) else ($e) {
        die("{$e}");
    }

    $sound->setPosition(ma::Vec3(4.0f, 0.0f, 0.0f));
    ma::Vec3 $p = $sound->position();
    assert($p->x > 3.9f && $p->x < 4.1f);
}
